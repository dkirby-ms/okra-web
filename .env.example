# API Configuration
VITE_API_BASE_URL=/api/v1

# Microsoft Entra ID Authentication
# Get these values from Azure Portal > Microsoft Entra ID > App registrations
VITE_AZURE_CLIENT_ID=your-client-id-here
VITE_AZURE_TENANT_ID=your-tenant-id-here
VITE_AZURE_REDIRECT_URI=http://localhost:5173

# Optional: API scope for backend access (if calling protected API)
# VITE_API_SCOPE=api://your-api-client-id/.default

# Optional: Session timeout in minutes (default: 60)
# VITE_SESSION_TIMEOUT_MINUTES=60
